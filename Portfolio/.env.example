# Copy this file to server/.env for local development (never commit the real .env).
# In production, set these as real environment variables on your host instead of a file.

# Postgres connection string (Neon or any Postgres host). Must include sslmode=require for Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared password for the /admin dashboard. Never expose this to client-side code.
ADMIN_PASSWORD=change-me

# Random secret used to sign admin session cookies (JWT). Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me

# Port the Go API server listens on.
PORT=8080

# Origin allowed to call the API with credentials during local development
# (the Vite dev server). In production this should be your real site origin,
# or can usually be left as-is since the API and site are served from the
# same origin by the single production binary.
ALLOWED_ORIGIN=http://localhost:5173

# "development" or "production" — controls whether the admin session cookie
# requires HTTPS (Secure flag).
APP_ENV=development

# Directory the Go server serves the built frontend from (relative to
# server/cmd/api or wherever the binary runs from).
STATIC_DIR=../dist
